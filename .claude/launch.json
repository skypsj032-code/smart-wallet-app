{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Flutter Web (Chrome)",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "chrome", "--web-port", "8080"],
      "port": 8080
    },
    {
      "name": "Flutter Windows",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "windows"],
      "port": null
    },
    {
      "name": "Build Runner Watch",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["pub", "run", "build_runner", "watch", "--delete-conflicting-outputs"],
      "port": null
    }
  ]
}
